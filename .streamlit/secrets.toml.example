# Copy this file to .streamlit/secrets.toml for local runs (never commit the real one).
# On Streamlit Community Cloud, paste the equivalent content into
# App settings -> Secrets instead of using this file.

ANTHROPIC_API_KEY = "sk-ant-..."
SPREADSHEET_ID = "put-your-google-sheet-id-here"

# Base64 of the ENTIRE service account JSON file downloaded from Google Cloud
# (Credentials -> your service account -> Keys -> Add Key -> JSON), not the
# JSON itself. Base64 has no quotes, backslashes, or newlines for a copy/paste
# step to mangle, which a literal PEM private key is very prone to.
#
# Generate it yourself, don't hand-type it:
#   macOS/Linux: base64 -i service-account.json | tr -d '\n'
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GCP_SERVICE_ACCOUNT_B64 = "ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsIC4uLiB9"
