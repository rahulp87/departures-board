# Copy this file to .streamlit/secrets.toml for local runs (never commit the real one).
# On Streamlit Community Cloud, paste the equivalent content into
# App settings -> Secrets instead of using this file.

ANTHROPIC_API_KEY = "sk-ant-..."
SPREADSHEET_ID = "put-your-google-sheet-id-here"

# The full JSON key downloaded when you create a Google Cloud service account,
# reshaped as a TOML table (see README.md "Google Sheets setup").
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "departures-board@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
